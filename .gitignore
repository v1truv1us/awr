.zig-cache/
zig-cache/
zig-out/

# Prevent accidental commits of locally-downloaded Zig toolchains when
# contributors follow ziglang.org/getting-started from the repo root.
/zig-x86_64-linux-*.tar.xz
/zig-x86_64-linux-*/

# Locally-cloned lexbor source (build from source per
# third_party/lexbor/BUILD_NOTES.md; the compiled static lib goes to
# /usr/local/lib and is linked by build.zig on Linux).
third_party/lexbor/*
!third_party/lexbor/BUILD_NOTES.md

# Local checkouts used to bypass Zig's HTTP fetch path in constrained
# environments. Bootstrapped by scripts/bootstrap_deps.sh.
third_party/libxev/
third_party/zig-quickjs-ng/
third_party/quickjs-ng-quickjs/

# Local Zig package cache — vestigial and never tracked. The real deps are
# local `.path` entries under third_party/ (bootstrapped by
# scripts/bootstrap_deps.sh, which applies the Zig-0.16 build.zig patches
# there). This resolved cache is regenerated by `zig build`; it duplicates
# third_party/ byte-for-byte and must stay out of the index.
zig-pkg/

# Solo per-session git worktrees — local-only scratch space for
# parallel task sessions, reaped via `solo worktree cleanup`. The
# tracking DB at .solo/solo.db is checked in; the worktrees are not.
.solo/worktrees/
.solo/*.db-shm
.solo/*.db-wal

# Local diagnostic captures and generated test comparison outputs.
errors/
*.actual.txt

# Stray local test binaries from ad-hoc `zig run` / `cc` experiments at the
# repo root — never commit (removed in the 2026-06-17 hygiene pass).
/test_io*
/test_reader*
